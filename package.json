{
  "name": "jiaoshoujia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && wrangler deploy --dry-run",
    "test": "vitest run",
    "auth:setup": "node scripts/auth-setup.mjs",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply jiaoshoujia --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply jiaoshoujia --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.5.2",
    "vite": "^8.2.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "otpauth": "^9.5.1",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  }
}
